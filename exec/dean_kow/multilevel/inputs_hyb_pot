# Hybrid with the external potential V = (x-1/4)^2 (x-3/4)^2 (pot_ky = 0: no
# y part), gamma = 2.2e-3, on the periodic domain [1/4, 3/4]^2 so the force is
# periodic (dV/dx = 0 at both wells, which meet at the periodic face; with a
# non-periodic force the two sides of the face apply different fluxes and mass
# is created). Boltzmann initial condition exp(-2V/gamma) with a mean of ic_npc
# particles per cell: ~170 per cell in the well, ~5 on the barrier at x = 1/2,
# which (cells with fewer than phierr particles) becomes the particle region,
# regridded every regrid_int steps. The SPDE drift, the particle drift and the
# ghost-cell sampler all use the same potential.
# Checks: time-averaged x-profile against exp(-2V/gamma); hybrid vs pure SPDE
# (amr.max_level = 0) vs pure particles (adv.phierr = 1e9).
#   mpirun -np 4 ./main2d.gnu.MPI.ex inputs_hyb_pot

max_step  = 20000
seed      = 1024
amrex.fpe_trap_invalid = 1

npts_scale = 1.
alg_type   = 0

geometry.prob_lo     =  0.25  0.25
geometry.prob_hi     =  0.75  0.75
geometry.is_periodic =  1    1
bc_lo = 0 0
bc_hi = 0 0

amr.v               = 1
amr.n_cell          = 64 64
amr.max_grid_size   = 32
amr.max_level       = 1
amr.use_particles   = 1
amr.ref_ratio       = 1
amr.blocking_factor = 2
amr.n_error_buf     = 1
amr.grid_eff        = 0.9
amr.regrid_int      = 100

adv.cfl        = 0.125
adv.do_reflux  = 1
adv.phierr     = 10.                 # particles where a cell holds < 10

adv.ext_pot    = 1
adv.pot_alpha  = 0.25
adv.pot_beta   = 0.75
adv.pot_gamma  = 2.2e-3
adv.pot_ky     = 0.
adv.ic_type    = 1                   # Boltzmann, mean ic_npc per cell
adv.ic_npc     = 40.

amr.plot_file  = plt_pot_
amr.plot_int   = 500
amr.chk_int    = -1
