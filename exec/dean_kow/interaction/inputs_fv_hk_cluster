# *****************************************************************
# 2D analog of the 1D Hegselmann-Krause clustering runs in
#   N. Gerber, R. S. Gvalani, M. Hairer, G. A. Pavliotis, A. Schlichting,
#   "Formation of clusters and coarsening in weakly interacting diffusions",
#   arXiv:2510.17629
# Their model, dX = -(1/N) sum_j W'(X_i - X_j) dt + sqrt(2) dB on [0,1),
#   W = gamma*ell*(1/2)((x/ell)^2 - 1) for |x| < ell,
# maps onto ip_type = hk with ip_R = ell, ip_eps = -gamma, diff_coeff = 1.
#
# This is the cheaper clustering run: gamma = 3000, ell = 0.1.
#   2D linear instability threshold gamma_sharp ~ 1316, so gamma/gamma_sharp ~ 2.3
#   fastest growing torus mode (1,3), growth rate ~ 265: about 10 initial clusters
#   well depth gamma*ell = 300, cluster width sigma = sqrt(ell/gamma) ~ 0.0058
# The uniform start is seeded only by the noise, so dorand must be 1.
# *****************************************************************

# *****************************************************************
# Run until nsteps == max_step or time == stop_time,
#     whichever comes first
# *****************************************************************
max_step  = 10000000
stop_time = 0.1            # ~25 e-foldings of the fastest mode

seed = 0

amrex.fpe_trap_invalid = 1

# *****************************************************************
# Specific to this application
# *****************************************************************
diff_coeff = 1.0           # paper uses unit diffusivity
alg_type = 0
dorand = 1.
num_part = 81920.          # sets the noise amplitude; ~8000 per initial cluster

# SPDE discretization options (defaults reproduce the original scheme)
#noise_avg_type  = 1       # 0: average of sqrt(phi); 1: smoothed Heaviside cutoff below one particle per cell
#drift_flux_type = 1       # 0: centered drift flux; 1: Scharfetter-Gummel (positivity-preserving, smaller dt)
#neg_diag_int    = 1000    # print min phi, negative cell fraction and negative mass every n steps (0 = off)

# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0  0.0
geometry.prob_hi     =  1.0  1.0
geometry.is_periodic =  1    1

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 512 512    # dx ~ 0.002, about 3 cells per sigma
amr.max_grid_size_x = 64 64
amr.max_grid_size_y = 64 64

amr.max_level       = 0
amr.use_particles   = 0      # Turn particles on or off
amr.ref_ratio       = 1

# Interaction potential (ip_ prefix)
amr.use_int_pot = 1
amr.ip_type     = hk       # ip_eps*ip_R*(1-(r/ip_R)^2)/2 for r < ip_R; ip_range defaults to ip_R
amr.ip_eps      = -3000.   # = -gamma; negative is attractive
amr.ip_R        = 0.1      # = ell

# External potential (ep_ prefix)
amr.use_ext_pot = 0

# *****************************************************************
# Control of grid creation
# *****************************************************************
amr.blocking_factor_x = 2
amr.blocking_factor_y = 2

amr.regrid_int      = 100000000  # how often to regrid

amr.n_error_buf = 0 0
amr.grid_eff = 0.96

# *****************************************************************
# Time step control
# *****************************************************************
adv.cfl            = 0.25    # fraction of the forward Euler stability limit

# *****************************************************************
# Should we reflux at coarse-fine boundaries?
# *****************************************************************
adv.do_reflux = 1

# *****************************************************************
# Tagging -  if phi < phierr at level 0, then refine
# *****************************************************************
adv.phierr = 10.

# *****************************************************************
# Plotfile name and frequency
# *****************************************************************
amr.plot_file  = plt_hk_   # root name of plot file
amr.plot_int   = 5000      # number of timesteps between plot files

# *****************************************************************
# Checkpoint name and frequency
# *****************************************************************
amr.chk_file = chk_hk_  # root name of checkpoint file
amr.chk_int  = 50000    # number of timesteps between checkpoint files
