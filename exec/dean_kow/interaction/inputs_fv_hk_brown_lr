# *****************************************************************
# 2D HK Brownian coalescence with a local repulsion (amr.ip_local_rep):
# the same run as inputs_fv_hk_brown (hk, gamma = 6000, ell = 0.1, 128^2,
# num_part = 4000) with C = U*phi + ip_local_rep*phi, a repulsive core
# narrower than a cell. For heavy clusters this fixes the cluster size
# (R_g ~ 0.3 ell) and makes the peak density grow like m instead of m^2,
# so clusters stay resolved as they merge (MODEL.md, section 3.8).
#   ip_local_rep = 0.471 = 0.1 |Uhat(0)|: acts as D -> D + 0.471 in the linear
#   stability, Lambda 4.6 -> 3.2 (code: 4.1 from the discrete minimum),
#   fastest mode (3,2), sigma ~ 780, ~11 clusters, nn ~ 0.32
#   N_c ~ 4000/11 ~ 360 particles per cluster
# Cost: inside a cluster the local term is a diffusion with coefficient
# ip_local_rep*phi, so the explicit step falls by about
# 1 + ip_local_rep*max(phi)/D (the startup line "interaction max_k
# keff^2*Uhat*cellvol" includes ip_local_rep*keff2_max).
# Compare with _hk_brown (same seed, no local repulsion).
# *****************************************************************

# *****************************************************************
# Run until nsteps == max_step or time == stop_time,
#     whichever comes first
# *****************************************************************
max_step  = 1000000
stop_time = 10.

seed = 0

amrex.fpe_trap_invalid = 1

# *****************************************************************
# Specific to this application
# *****************************************************************
diff_coeff = 1.0           # paper uses unit diffusivity
alg_type = 0
dorand = 1.
num_part = 4000.           # N_c ~ 360 per initial cluster; sets the Brownian time

# SPDE discretization options (defaults reproduce the original scheme)
noise_avg_type  = 1        # 0: average of sqrt(phi); 1: smoothed Heaviside cutoff below one particle per cell
drift_flux_type = 1        # 0: centered drift flux; 1: Scharfetter-Gummel (positivity-preserving, dt limited by measured drift)
neg_diag_int    = 10000    # print min phi, negative cell fraction and negative mass every n steps (0 = off)
#drift_diag_int  = 10000   # print drift CFL number and max cell Peclet number every n steps (0 = off)
#drift_cfl       = 0.5     # also limit dt*sum_d max|grad(C+V_ext)|/dx_d <= drift_cfl (0 = off)

# *****************************************************************
# Are we restarting from an existing checkpoint file?
# *****************************************************************
#amr.restart  = chk_hklr_100000 # restart from this checkpoint file

# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0  0.0
geometry.prob_hi     =  1.0  1.0
geometry.is_periodic =  1    1

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 128 128    # dx ~ 0.0078: ell = 12.8 cells, sigma_c ~ 2 cells
amr.max_grid_size_x = 32 32
amr.max_grid_size_y = 32 32

amr.max_level       = 0
amr.use_particles   = 0      # Turn particles on or off
amr.ref_ratio       = 1

# Interaction potential (ip_ prefix)
amr.use_int_pot = 1
amr.ip_type     = hk       # ip_eps*ip_R*(1-(r/ip_R)^2)/2 for r < ip_R; ip_range defaults to ip_R
amr.ip_eps      = -6000.   # = -gamma; negative is attractive
amr.ip_R        = 0.1      # = ell
amr.ip_local_rep = 0.471   # local repulsion: C = U*phi + ip_local_rep*phi (mesh only)

# External potential (ep_ prefix)
amr.use_ext_pot = 0

# *****************************************************************
# Control of grid creation
# *****************************************************************
amr.blocking_factor_x = 2
amr.blocking_factor_y = 2

amr.regrid_int      = 100000000  # how often to regrid

amr.n_error_buf = 0 0
amr.grid_eff = 0.96

# *****************************************************************
# Time step control
# *****************************************************************
adv.cfl            = 0.5     # fraction of the forward Euler stability limit; SG keeps phi >= 0 (deterministic part) for cfl <= 1

# *****************************************************************
# Should we reflux at coarse-fine boundaries?
# *****************************************************************
adv.do_reflux = 1

# *****************************************************************
# Tagging -  if phi < phierr at level 0, then refine
# *****************************************************************
adv.phierr = 10.

# *****************************************************************
# Plotfile name and frequency
# *****************************************************************
amr.plot_file  = plt_hklr_   # root name of plot file
amr.plot_int   = 5000       # dt ~ 1.3e-6: ~0.0065 in time, 200 plotfiles

# *****************************************************************
# Checkpoint name and frequency
# *****************************************************************
amr.chk_file = chk_hklr_  # root name of checkpoint file
amr.chk_int  = 100000    # number of timesteps between checkpoint files
