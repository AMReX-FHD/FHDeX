# *****************************************************************
# 2D cluster formation followed by tail-driven mergers, using the piecewise
# parabolic potential of
#   N. Gerber, R. S. Gvalani, M. Hairer, G. A. Pavliotis, A. Schlichting,
#   "Formation of clusters and coarsening in weakly interacting diffusions",
#   arXiv:2510.17629
#   W = gamma*ell*w(x/ell), w = alpha(s^2-a^2)/2 + beta(a^2-1)/2 for s <= a,
#                           w = beta(s^2-1)/2 for a < s <= 1
# mapped onto ip_type = pp with ip_R = ell, ip_eps = -gamma, diff_coeff = 1.
#
# The strong core (radius a*ell = 0.12) sets the initial pattern: fastest
# torus mode (3,1), about 10 clusters about 0.32 apart. That spacing is inside
# the weak tail (radius ell = 0.45), so neighbouring clusters attract and merge
# by drift instead of by the slow, N-dependent cluster random walk that HK
# relies on. beta >= 0.03 lets the tail take over and gives a single cluster.
#   cluster width sigma = sqrt(ell/(gamma*alpha)) ~ 0.0079, about 2 cells
# *****************************************************************

# *****************************************************************
# Run until nsteps == max_step or time == stop_time,
#     whichever comes first
# *****************************************************************
max_step  = 10000000
stop_time = 0.05           # ~10 clusters by t ~ 0.02, merged into one by t ~ 0.04 (seed 11)

seed = 0

amrex.fpe_trap_invalid = 1

# *****************************************************************
# Specific to this application
# *****************************************************************
diff_coeff = 1.0           # paper uses unit diffusivity
alg_type = 0
dorand = 1.
num_part = 327680.         # 5 particles per cell on 256^2

# SPDE discretization options (defaults reproduce the original scheme)
#noise_avg_type  = 1       # 0: average of sqrt(phi); 1: smoothed Heaviside cutoff below one particle per cell
#drift_flux_type = 1       # 0: centered drift flux; 1: Scharfetter-Gummel (positivity-preserving, dt limited by measured drift)
#neg_diag_int    = 1000    # print min phi, negative cell fraction and negative mass every n steps (0 = off)
#drift_diag_int  = 1000    # print drift CFL number and max cell Peclet number every n steps (0 = off)
#drift_cfl       = 0.5     # also limit dt*sum_d max|grad(C+V_ext)|/dx_d <= drift_cfl (0 = off)

# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0  0.0
geometry.prob_hi     =  1.0  1.0
geometry.is_periodic =  1    1

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 256 256    # dx ~ 0.0039, about 2 cells per sigma
amr.max_grid_size_x = 64 64
amr.max_grid_size_y = 64 64

amr.max_level       = 0
amr.use_particles   = 0      # Turn particles on or off
amr.ref_ratio       = 1

# Interaction potential (ip_ prefix)
amr.use_int_pot = 1
amr.ip_type     = pp       # piecewise parabolic; ip_range defaults to ip_R
amr.ip_eps      = -7300.   # = -gamma; negative is attractive
amr.ip_R        = 0.45     # = ell, tail radius
amr.ip_pp_a     = 0.27     # core radius / ip_R
amr.ip_pp_alpha = 1.       # core stiffness
amr.ip_pp_beta  = 0.02     # tail stiffness

# External potential (ep_ prefix)
amr.use_ext_pot = 0

# *****************************************************************
# Control of grid creation
# *****************************************************************
amr.blocking_factor_x = 2
amr.blocking_factor_y = 2

amr.regrid_int      = 100000000  # how often to regrid

amr.n_error_buf = 0 0
amr.grid_eff = 0.96

# *****************************************************************
# Time step control
# *****************************************************************
adv.cfl            = 0.25    # fraction of the forward Euler stability limit

# *****************************************************************
# Should we reflux at coarse-fine boundaries?
# *****************************************************************
adv.do_reflux = 1

# *****************************************************************
# Tagging -  if phi < phierr at level 0, then refine
# *****************************************************************
adv.phierr = 10.

# *****************************************************************
# Plotfile name and frequency
# *****************************************************************
amr.plot_file  = plt_pp_   # root name of plot file
amr.plot_int   = 1000      # about every 0.0003-0.001 in time; ~100 plotfiles for space-time stacking

# *****************************************************************
# Checkpoint name and frequency
# *****************************************************************
amr.chk_file = chk_pp_  # root name of checkpoint file
amr.chk_int  = 20000    # number of timesteps between checkpoint files
