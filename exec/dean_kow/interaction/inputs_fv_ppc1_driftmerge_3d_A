# *****************************************************************
# 3D ppc1 drift-merge, option A (128^3, core 0.08). 3D partner of
# inputs_fv_ppc1_driftmerge_n50; pair with inputs_fv_ppc1_collapse_3d_A.
#   core radius 0.08 (10 cells), core Uhat(0) = -5; tail radius 0.26,
#   tail Uhat(0) = -1.5
#   Core and tail integrals Uhat(0) are those of the 2D pair (core -5, tail
#   -1 in 2D; -1.5 here for a pair time like the 2D one); the amplitude ip_eps is larger in 3D, since the same integral over a
#   ball of radius b needs a depth ~ 105/(96 b) times the 2D one.
# Cost is set by the number of steps: a survivor of n formation clusters has
# peak phi ~ 47 n and max cell Pe ~ n x Pe at formation, and dt ~ 1/(ip_local_rep
# * max phi) once merging. Equilibrium-cluster estimates below; "steps" are
# per 0.01 of simulated time and do not depend on the number of ranks.
#   fastest mode sigma ~ 2040 at wavelength 0.171: ~161 clusters ~0.20 apart,
#     R/nn = 1.30: nearest neighbours only
#   cluster-gas rate largest (134) at wavelength 0.41, 51 at the box scale
#     (ratio 0.38; 2D partner 0.32)
#   pair approach time from one spacing ~ 0.020
#   n = 1: Pe 5.7, peak 45, ~57k steps; n = 2: Pe 12, peak 95, ~120k steps;
#     n = 4: Pe 25, peak 193, ~240k steps; SG faces 0.1-0.2%
# Hybrid drift flux, smoothed-Heaviside noise.
# *****************************************************************

# *****************************************************************
# Run until nsteps == max_step or time == stop_time,
#     whichever comes first
# *****************************************************************
max_step  = 10000000
stop_time = 0.08

seed = 1

amrex.fpe_trap_invalid = 1

# *****************************************************************
# Specific to this application
# *****************************************************************
diff_coeff = 1.0
alg_type = 0
dorand = 1.
num_part = 10485760.       # 5 particles per cell on 128^3

# SPDE discretization options (defaults reproduce the original scheme)
noise_avg_type  = 1        # 0: average of sqrt(phi); 1: smoothed Heaviside cutoff below one particle per cell
drift_flux_type = 2        # 0: centered; 1: Scharfetter-Gummel; 2: hybrid (centered where cell Pe <= 2, SG above)
neg_diag_int    = 1000     # print min phi, negative cell fraction and negative mass every n steps (0 = off)
drift_diag_int  = 1000     # print drift CFL number and max cell Peclet number every n steps (0 = off)
#drift_cfl       = 0.5     # also limit dt*sum_d max|grad(C+V_ext)|/dx_d <= drift_cfl (0 = off)

# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0  0.0  0.0
geometry.prob_hi     =  1.0  1.0  1.0
geometry.is_periodic =  1    1    1

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 128 128 128   # dx ~ 0.0078: core radius 10 cells
amr.max_grid_size_x = 32 32
amr.max_grid_size_y = 32 32
amr.max_grid_size_z = 32 32

amr.max_level       = 0
amr.use_particles   = 0      # Turn particles on or off
amr.ref_ratio       = 1

# Interaction potential (ip_ prefix)
amr.use_int_pot = 1
amr.ip_type      = ppc1     # C1 piecewise parabolic; ip_range defaults to ip_R
amr.ip_eps       = -1.6588e6 # negative is attractive
amr.ip_R         = 0.26     # tail radius: 1.3 cluster spacings
amr.ip_pp_a      = 0.30769 # core radius / ip_R: core radius 0.08
amr.ip_pp_alpha  = 1.       # core stiffness (attractive core)
amr.ip_pp_beta   = 8.2669e-4  # tail stiffness: tail |Uhat(0)| = 0.3 x core |Uhat(0)|
amr.ip_local_rep = 0.5      # local repulsion: C = U*phi + ip_local_rep*phi (mesh only)

# External potential (ep_ prefix)
amr.use_ext_pot = 0

# *****************************************************************
# Control of grid creation
# *****************************************************************
amr.blocking_factor_x = 2
amr.blocking_factor_y = 2
amr.blocking_factor_z = 2

amr.regrid_int      = 100000000  # how often to regrid

amr.n_error_buf = 0 0
amr.grid_eff = 0.96

# *****************************************************************
# Time step control
# *****************************************************************
adv.cfl            = 0.5     # fraction of the forward Euler stability limit; SG keeps phi >= 0 (deterministic part) for cfl <= 1

# *****************************************************************
# Should we reflux at coarse-fine boundaries?
# *****************************************************************
adv.do_reflux = 1

# *****************************************************************
# Tagging -  if phi < phierr at level 0, then refine
# *****************************************************************
adv.phierr = 10.

# *****************************************************************
# Plotfile name and frequency
# *****************************************************************
amr.plot_file  = plt_dA_    # root name of plot file
amr.plot_int   = 4000

# *****************************************************************
# Checkpoint name and frequency
# *****************************************************************
amr.chk_file = chk_dA_   # root name of checkpoint file
amr.chk_int  = 50000   # number of timesteps between checkpoint files
