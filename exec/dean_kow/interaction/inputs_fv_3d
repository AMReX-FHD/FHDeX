# *****************************************************************
# Run until nsteps == max_step or time == stop_time,
#     whichever comes first
# *****************************************************************
# Reduced from 100000 for a first 3D smoke run -- raise for production.
max_step  = 60000

seed = 0

amrex.fpe_trap_invalid = 1

# *****************************************************************
# Specific to this application
# *****************************************************************
diff_coeff = 0.5
diff_coeff = .46
diff_coeff = 1.
diff_coeff = .25
alg_type = 0
dorand = 0.
dorand = 1.
num_part = 20480.
num_part = 327680.
num_part = 81920.
num_part = 400000.
num_part = 10000000.
num_part = 20000000.

# *****************************************************************
# Are we restarting from an existing checkpoint file?
# *****************************************************************
#amr.restart  = chk00060 # restart from this checkpoint file

# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0  0.0  0.0
geometry.prob_hi     =  1.0  1.0  1.0
geometry.is_periodic =  1    1    1
#bc_lo = 3 3
#bc_hi = 3 3

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************

amr.n_cell          = 128 128 128
amr.max_grid_size_x = 32
amr.max_grid_size_y = 32
amr.max_grid_size_z = 32

amr.max_level       = 0
amr.use_particles   = 0      # Turn particles on or off
amr.ref_ratio       = 1

# Interaction potential (ip_ prefix)
amr.use_int_pot = 1        # 1 = on, 0 = off
amr.ip_type     = gema     # gema: ip_eps*exp(-(r/ip_R)^ip_alpha); hk: ip_eps*ip_R*(1-(r/ip_R)^2)/2, 0 for r >= ip_R; morse: see below
amr.ip_eps      = 4509.
amr.ip_R        = 0.1
amr.ip_alpha    = 3.       # gema only
#amr.ip_type    = hk       # HK example; ip_range defaults to ip_R
#amr.ip_type    = morse    # U = -ip_eps_att*exp(-(r-ip_re)/ip_R_att) + ip_eps_rep*exp(-(r-ip_re)/ip_R_rep)
#amr.ip_eps_att = 2.       # must exceed ip_eps_rep
#amr.ip_eps_rep = 1.
#amr.ip_R_att   = 0.1      # must exceed ip_R_rep
#amr.ip_R_rep   = 0.05
#amr.ip_re      = 0.       # default 0
#amr.ip_range   = 0.3125   # particle pair cutoff; only used with particles

# External potential (ep_ prefix)
amr.use_ext_pot = 0        # 1 = on, 0 = off
#amr.ep_alpha    = 0.25
#amr.ep_beta     = 0.75
#amr.ep_gamma    = 1.1e-3

#amr.max_level       = 0
#amr.use_particles   = 0      # Turn particles on or off

# *****************************************************************
# Control of grid creation
# *****************************************************************
# Blocking factor for grid creation in each dimension --
#   this ensures that every grid is coarsenable by a factor of 8 --
#   this is mostly relevant for multigrid performance
amr.blocking_factor_x = 2
amr.blocking_factor_y = 2
amr.blocking_factor_z = 8

amr.regrid_int      = 100000000  # how often to regrid

amr.n_error_buf = 0 0
amr.grid_eff = 0.96
#amr.grid_eff = 0.7

# *****************************************************************
# Time step control
# *****************************************************************
adv.cfl            = 0.01    # CFL constraint
adv.cfl            = 0.03125    # CFL constraint
adv.cfl            = 0.1    # CFL constraint

# *****************************************************************
# Should we reflux at coarse-fine boundaries?
# *****************************************************************
adv.do_reflux = 1

# *****************************************************************
# Tagging -  if phi < phierr at level 0, then refine
# *****************************************************************
adv.phierr = 10.

# *****************************************************************
# Plotfile name and frequency
# *****************************************************************
amr.plot_file  = plt_fv3d_   # root name of plot file
amr.plot_int   =  100    # number of timesteps between plot files
                        # if negative then no plot files will be written

# *****************************************************************
# Checkpoint name and frequency
# *****************************************************************
amr.chk_file = chk      # root name of checkpoint file
amr.chk_int  = 100       # number of timesteps between checkpoint files
                        # if negative then no checkpoint files will be written
