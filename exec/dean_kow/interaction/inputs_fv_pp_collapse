# *****************************************************************
# 2D collective collapse of a cluster gas (MODEL.md section 3.10).
# pp potential plus a local repulsion, i.e. three pieces:
#   repulsive core   ip_local_rep (C = U*phi + ip_local_rep*phi), keeps the
#                    clusters resolved as they merge (section 3.8)
#   strong core      radius a*R = 0.06, sets ~30 initial clusters ~0.19 apart
#   weak tail        radius R = 0.45, much longer than the spacing
# The tail does not pull neighbours together pairwise. The clusters are a cold
# gas (diffusivity D/N_c ~ 1e-4) that the tail makes unstable at the largest
# scales: rate k^2 |Uhat_tail(k)| ~ 190, peaked at wavelength ~0.93, about
# the box. Clusters stream toward one or two centres and merge in bunches.
#   pp with ip_R = 0.45, ip_pp_a = 0.1333, ip_pp_alpha = 1, ip_pp_beta = 6.32e-4,
#   ip_eps = -2.212e5: main piece |Uhat(0)| = 5, tail |Uhat(0)| = 10
#   ip_local_rep = 0.5: D -> D + 0.5; fastest mode |k| = 6*2pi, sigma ~ 2450,
#   t_form ~ ln N/(2 sigma) ~ 0.003, ~31 clusters, m ~ 0.03
#   collapse: several e-foldings of 1/190 ~ 0.005, so t ~ 0.02-0.04
# Cost: the final cluster holds most of the mass; with the local repulsion its
# peak grows like m, and the explicit step falls by about
# 1 + ip_local_rep*max(phi)/D, so the step shrinks strongly near the end.
# *****************************************************************

# *****************************************************************
# Run until nsteps == max_step or time == stop_time,
#     whichever comes first
# *****************************************************************
max_step  = 10000000
stop_time = 0.05

seed = 0

amrex.fpe_trap_invalid = 1

# *****************************************************************
# Specific to this application
# *****************************************************************
diff_coeff = 1.0
alg_type = 0
dorand = 1.
num_part = 327680.         # 5 particles per cell on 256^2

# SPDE discretization options (defaults reproduce the original scheme)
#noise_avg_type  = 1       # 0: average of sqrt(phi); 1: smoothed Heaviside cutoff below one particle per cell
drift_flux_type = 1        # 0: centered drift flux; 1: Scharfetter-Gummel (positivity-preserving, dt limited by measured drift)
neg_diag_int    = 1000     # print min phi, negative cell fraction and negative mass every n steps (0 = off)
#drift_diag_int  = 1000    # print drift CFL number and max cell Peclet number every n steps (0 = off)
#drift_cfl       = 0.5     # also limit dt*sum_d max|grad(C+V_ext)|/dx_d <= drift_cfl (0 = off)

# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0  0.0
geometry.prob_hi     =  1.0  1.0
geometry.is_periodic =  1    1

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************
amr.n_cell          = 256 256    # dx ~ 0.0039: core radius 15 cells
amr.max_grid_size_x = 64 64
amr.max_grid_size_y = 64 64

amr.max_level       = 0
amr.use_particles   = 0      # Turn particles on or off
amr.ref_ratio       = 1

# Interaction potential (ip_ prefix)
amr.use_int_pot = 1
amr.ip_type      = pp       # piecewise parabolic; ip_range defaults to ip_R
amr.ip_eps       = -2.212e5 # negative is attractive
amr.ip_R         = 0.45     # tail radius
amr.ip_pp_a      = 0.1333   # core radius / ip_R: core radius 0.06
amr.ip_pp_alpha  = 1.       # core stiffness
amr.ip_pp_beta   = 6.32e-4  # tail stiffness: tail |Uhat(0)| = 2 x main |Uhat(0)|
amr.ip_local_rep = 0.5      # local repulsion: C = U*phi + ip_local_rep*phi (mesh only)

# External potential (ep_ prefix)
amr.use_ext_pot = 0

# *****************************************************************
# Control of grid creation
# *****************************************************************
amr.blocking_factor_x = 2
amr.blocking_factor_y = 2

amr.regrid_int      = 100000000  # how often to regrid

amr.n_error_buf = 0 0
amr.grid_eff = 0.96

# *****************************************************************
# Time step control
# *****************************************************************
adv.cfl            = 0.5     # fraction of the forward Euler stability limit; SG keeps phi >= 0 (deterministic part) for cfl <= 1

# *****************************************************************
# Should we reflux at coarse-fine boundaries?
# *****************************************************************
adv.do_reflux = 1

# *****************************************************************
# Tagging -  if phi < phierr at level 0, then refine
# *****************************************************************
adv.phierr = 10.

# *****************************************************************
# Plotfile name and frequency
# *****************************************************************
amr.plot_file  = plt_ppc_   # root name of plot file
amr.plot_int   = 1000

# *****************************************************************
# Checkpoint name and frequency
# *****************************************************************
amr.chk_file = chk_ppc_  # root name of checkpoint file
amr.chk_int  = 20000    # number of timesteps between checkpoint files
