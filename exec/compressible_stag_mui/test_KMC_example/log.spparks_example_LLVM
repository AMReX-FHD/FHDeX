SPPARKS (18 May 2017)
app_style   lotkavolterra
seed        1000

dimension   2
boundary    p p p

# Lattice
variable    n1x          equal 300
variable    n1y          equal 300

lattice     sq/4n 1.0
region      sys_domain block 0 ${n1x} 0 ${n1y} -0.5 0.5 # n1x * n1y sites
region      sys_domain block 0 300 0 ${n1y} -0.5 0.5 region      sys_domain block 0 300 0 300 -0.5 0.5 create_box  sys_domain
Created box = (0 0 -0.5) to (300 300 0.5)
  1 by 1 by 1 processor grid
create_sites box
Creating sites ...
  90000 sites
  90000 sites have 4 neighbors

# Setting
variable    Trun   equal 1.0e-12   # time step
variable    nstep  equal 100       # total number of time step
variable    Time   equal ${Trun}*${nstep}
variable    Time   equal 1e-12*${nstep}
variable    Time   equal 1e-12*100
variable    Tstat  equal ${Trun}   # time step for stats
variable    Tstat  equal 1e-12   
solve_style tree
sector      yes tstop ${Trun}
sector      yes tstop 1e-12

temperature 600.

###########################

# i1:       1 (siteA)
# i2:       0 (vac) 1 (spec1) 2 (spec2)
# i3 - i4:  ac1-ac2 = number of adsorption events of the species at the site
# i5 - i6:  dc1-dc2 = number of desoprtion events of the species at the site
# d1 - d2:  pressure1-2 = partial pressure of the fluid cell right above the site 
# d3:       temperature

set         i1 value 1                                 # all siteA
  90000 settings made for i1
set         i2 value 0                                 # all vac
  90000 settings made for i2
set         i2 value 1 fraction 0.2                    # initial species 1 (0.2)
  18050 settings made for i2
set         i2 value 2 fraction 0.375 if i2 = 0        # initial species 2 (0.3 = 0.8 * 0.375)
  27133 settings made for i2

event       1 siteA siteA vac   spec1 2.000000e+07 spec1 spec1  # O + A -> A + A
event       2 siteA siteA spec1 spec2 2.000000e+07 spec2 spec2  # A + B -> B + B
event       3 siteA       spec2       6.666667e+06 vac          #     B -> E

###########################

stats       ${Tstat}
stats       1e-12

diag_style  lotkavolterra stats yes list vac spec1 spec2 O1 A1 B1
# vac, spec1, spec2: number of vacancy, species 1, speceis 2
# O1, A1, B1: number of events (event 1, event 2, event 3)

run ${Time} pre no post no
run 1e-10 pre no post no
