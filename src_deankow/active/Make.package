CEXE_sources += main.cpp

CEXE_headers += ActiveParams.H
CEXE_sources += DensityConv.cpp
CEXE_headers += DensityConv.H

# DIM = 3: SPDE on (x, y, theta)
ifeq ($(DIM),3)
CEXE_sources += AmrCoreActive.cpp
CEXE_sources += AdvancePhiAtLevel.cpp
CEXE_sources += myfunc.cpp

CEXE_headers += AmrCoreActive.H
CEXE_headers += myfunc.H
CEXE_headers += mykernel.H
endif

# DIM = 2: particles with a theta attribute
ifeq ($(DIM),2)
CEXE_sources += ActivePC.cpp
CEXE_sources += ActiveParticles.cpp

CEXE_headers += ActivePC.H
CEXE_headers += ActiveParticles.H
endif
